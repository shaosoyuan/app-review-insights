# ===== LLM Configuration =====
# At least one provider must be configured for model-driven semantic analysis.
# The application supports any OpenAI-compatible API.

# OpenAI (default)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (alternative)
# OPENAI_API_KEY=your-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# Other OpenAI-compatible providers (Qwen, Moonshot, etc.)
# OPENAI_API_KEY=your-key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus

# ===== Data Collection =====
# Max reviews to fetch from iTunes RSS API (max 500 per request)
MAX_REVIEWS=500

# Request timeout in seconds
REQUEST_TIMEOUT=30

# ===== Server =====
# Backend API port
API_PORT=8000

# Frontend port
FRONTEND_PORT=5173
